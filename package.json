{
  "name": "apiforge",
  "version": "0.1.0",
  "description": "ApiForge: Postman-style API client (Electron shell + postman-runtime worker)",
  "main": "dist/src/main/main.js",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node dist/scripts/build.js",
    "check": "tsc --noEmit -p tsconfig.json",
    "start": "npm run build && electron .",
    "test": "npm run build && node --test --test-timeout=30000 dist/test/*.test.js",
    "smoke": "npm run build && node dist/test/smoke.js",
    "lint": "eslint .",
    "icon": "npm run build && electron dist/scripts/build-icon.js"
  },
  "license": "MIT",
  "dependencies": {
    "@postman/tough-cookie": "^4.1.3-postman.1",
    "js-yaml": "^4.3.2",
    "postman-collection": "^5.3.1",
    "postman-runtime": "^7.56.2",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.20.5",
    "@types/postman-collection": "^3.5.11",
    "@types/ws": "^8.18.2",
    "electron": "^44.9.1",
    "esbuild": "^0.25.12",
    "eslint": "^9.39.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0"
  },
  "productName": "ApiForge",
  "author": {
    "name": "Basharshaeb",
    "url": "https://github.com/Basharshaeb"
  },
  "homepage": "https://github.com/Basharshaeb",
  "repository": {
    "type": "git",
    "url": "https://github.com/Basharshaeb/ApiForge.git"
  },
  "build": {
    "appId": "com.basharshaeb.apiforge",
    "productName": "ApiForge",
    "win": {
      "icon": "assets/icon.ico"
    },
    "mac": {
      "icon": "assets/icon.icns"
    },
    "linux": {
      "icon": "assets/icon-512.png"
    }
  }
}
