{
  "name": "apiforge",
  "version": "0.1.0",
  "description": "ApiForge: Postman-style API client (Electron shell + postman-runtime worker)",
  "main": "src/main/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test --test-timeout=30000 test/*.test.js",
    "smoke": "node test/smoke.js",
    "icon": "electron scripts/build-icon.js"
  },
  "license": "MIT",
  "dependencies": {
    "@postman/tough-cookie": "^4.1.3-postman.1",
    "js-yaml": "^4.3.2",
    "postman-collection": "^5.3.1",
    "postman-runtime": "^7.56.2",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "electron": "^44.9.1"
  },
  "productName": "ApiForge",
  "author": {
    "name": "Basharshaeb",
    "url": "https://github.com/Basharshaeb"
  },
  "homepage": "https://github.com/Basharshaeb",
  "repository": {
    "type": "git",
    "url": "https://github.com/Basharshaeb/ApiForge.git"
  },
  "build": {
    "appId": "com.basharshaeb.apiforge",
    "productName": "ApiForge",
    "win": {
      "icon": "assets/icon.ico"
    },
    "mac": {
      "icon": "assets/icon.icns"
    },
    "linux": {
      "icon": "assets/icon-512.png"
    }
  }
}
